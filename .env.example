# IMAP Settings
IMAP_HOST=zmail.hktv.com.hk
IMAP_PORT=993
IMAP_USER=your_email@hktv.com.hk
IMAP_PASS=your_password
IMAP_FOLDER=INBOX
IMAP_DAILY_FOLDER=BI - Daily Sales Update

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_EXTRA_CHAT_IDS=other_chat_id1,other_chat_id2

# Anthropic (for natural language queries via Telegram)
ANTHROPIC_API_KEY=sk-ant-...

# Storage
DB_PATH=data/sales.db

# Folder where the daily Tableau Category Performance xlsx is dropped
CATEGORY_DIR=data/category

# Anomaly detection — flag if Z-score exceeds this threshold
ANOMALY_Z_THRESHOLD=2.0

# Minimum avg volume for a gateway to be included in anomaly checks
MIN_GATEWAY_VOLUME=20

# Tableau Server automation (for auto-downloading Category Performance xlsx)
TABLEAU_SERVER=https://inhouse-analytics.hktv.com.hk
TABLEAU_USERNAME=your_tableau_username
TABLEAU_PASSWORD=your_tableau_password
TABLEAU_ACCESS_KEY=your_access_key
# Set to false to watch the browser (debugging); true for background/production
TABLEAU_HEADLESS=true
